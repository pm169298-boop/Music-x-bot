#!/usr/bin/env bash
set -e

echo "=========================================================="
echo "      Music-x-bot Automated Single-File Setup"
echo "=========================================================="

# Check sudo
SUDO=""
if [ "$EUID" -ne 0 ]; then
    if command -v sudo &>/dev/null; then
        SUDO="sudo"
    fi
fi

echo "[1/4] Installing system dependencies (Python3, FFmpeg, Git)..."
if command -v apt-get &>/dev/null; then
    $SUDO apt-get update -y
    $SUDO apt-get install -y python3 python3-pip python3-venv ffmpeg curl git
fi

echo "[2/4] Installing Python requirements from requirements.txt..."
python3 -m pip install --upgrade pip
python3 -m pip install -r requirements.txt

echo "[3/4] Enter your Bot Configuration values below:"
echo "----------------------------------------------------------"
read -rp "Telegram API_ID: " api_id
read -rp "Telegram API_HASH: " api_hash
read -rp "Bot Token (from @BotFather): " bot_token
read -rp "Assistant Session (from @StringFatherBot): " session_str
read -rp "Owner ID (from @userinfobot): " owner_id
read -rp "Logger Group ID (e.g. -100...): " logger_id
echo "----------------------------------------------------------"
echo "Firebase Setup (Press ENTER to skip and use Local VPS mode):"
read -rp "Firebase Realtime DB URL (leave blank for Local VPS): " fb_url
fb_creds=""
if [ -n "$fb_url" ]; then
    read -rp "Firebase Credentials File (e.g. firebase_key.json): " fb_creds
fi

echo "[4/4] Writing configuration to .env file..."
cat > .env <<EOF
API_ID=$api_id
API_HASH=$api_hash
BOT_TOKEN=$bot_token
SESSION=$session_str
OWNER_ID=$owner_id
LOGGER_ID=$logger_id
FIREBASE_DATABASE_URL=$fb_url
FIREBASE_CREDENTIALS=$fb_creds
BACKUP_INTERVAL_HOURS=6
MAX_BACKUPS_RETAINED=10
COOKIES_FILE=cookies.txt
EOF

chmod +x start setup

echo ""
echo "=========================================================="
echo " Setup Complete! You can now start your bot using:"
echo "   python3 main.py"
echo "   OR"
echo "   bash start"
echo "=========================================================="
