# ==============================================================================
#  Music-x-bot — sample.env
#  Copy karein:  cp sample.env .env   (phir apni values bharein)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) TELEGRAM CREDENTIALS (MANDATORY)
# ------------------------------------------------------------------------------
# https://my.telegram.org -> API Development Tools
API_ID=
API_HASH=

# @BotFather se /newbot karke token lein
BOT_TOKEN=

# Aapka numeric Telegram user id (@userinfobot) — owner commands ke liye
OWNER_ID=

# Private log group id (-100...). Bot + assistant dono ko admin banayein.
# Isi group me logs, play logs AUR automated database backups aayenge.
LOGGER_ID=

# Assistant account ka Pyrogram v2 string session (@StringFatherBot)
SESSION=

# Extra assistants (optional) — multi-assistant load balancing ke liye
SESSION2=
SESSION3=
SESSION4=

# Extra sudo users (comma separated user ids, optional) — OWNER_ID always sudo hota hai
SUDO_USERS=

# Agar True: LOGGER_ID group na milne par bot start hi nahi hoga (strict mode)
STRICT_LOGGER=False


# ------------------------------------------------------------------------------
# 2) DATABASE — OPTION A: FIREBASE REALTIME DATABASE (optional)
# ------------------------------------------------------------------------------
# Firebase Console -> Realtime Database banayein, phir:
#   * database URL yahan daalein
#   * Service Account key (Project Settings -> Service accounts -> Generate key)
#     ko firebase_key.json naam se project folder me rakhein, YA uska pura JSON
#     content FIREBASE_CREDENTIALS_JSON me paste kar dein.
FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS=firebase_key.json
FIREBASE_CREDENTIALS_JSON=
# Optional: Firebase Storage bucket (backups cloud par bhi rakhne ke liye)
FIREBASE_STORAGE_BUCKET=
# Firebase ke andar root node ka naam
FIREBASE_ROOT=musicbot
# Cloud sync interval (seconds me)
FIREBASE_SYNC_INTERVAL=60

# ------------------------------------------------------------------------------
# 3) DATABASE — OPTION B: LOCAL VPS STORAGE + AUTOMATED BACKUP (default)
# ------------------------------------------------------------------------------
# Agar upar Firebase blank hai (ya connect fail ho jaaye) to bot automatic:
#   * data/database.json  -> local storage (atomic writes)
#   * data/backups/       -> timestamped snapshots
#   * LOGGER_ID           -> har backup Telegram par document ban kar
DATA_DIR=data
BACKUP_DIR=data/backups
BACKUP_INTERVAL_HOURS=6
MAX_BACKUPS_RETAINED=10
BACKUP_GZIP=True
BACKUP_ON_START=True
BACKUP_ON_SHUTDOWN=True
BACKUP_TO_LOGGER=True
# Optional: mounted disk / rclone mount jahan backup ki extra copy jaaye
BACKUP_REMOTE_DIR=


# ------------------------------------------------------------------------------
# 4) YOUTUBE COOKIES (OPTIONAL but recommended on VPS/datacenter)
# ------------------------------------------------------------------------------
# cookies.txt (Netscape format) project root me rakhein — .gitignore me hai,
# isliye ye kabhi GitHub par push nahi hoga.
COOKIES_FILE=cookies.txt
COOKIES_DIR=cookies
# Ya cookies ko env me rakhein (Heroku/Railway jaisi ephemeral filesystem ke liye):
# COOKIES_CONTENT=# Netscape HTTP Cookie File ...
# COOKIES_B64=<base64 of cookies.txt content>
# COOKIES_URL=https://batbin.me/xxxxx
COOKIE_ENABLED=True
# yt-dlp player client override (kabhi kabhi "web,android" help karta hai)
YTDLP_PLAYER_CLIENT=


# ------------------------------------------------------------------------------
# 5) PLAYBACK / LIMITS
# ------------------------------------------------------------------------------
DURATION_LIMIT=60          # minutes (0 = no limit)
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20
SEARCH_RESULTS=15
VIDEO_PLAY=True            # False -> /vplay disable
THUMB_GEN=True             # custom thumbnail generation
AUTO_LEAVE=False           # assistant ko inactive groups se auto-leave
AUTO_END=False             # VC me koi na ho to auto end
VC_WATCHER=True
TIMER_UPDATE=12            # now-playing timer refresh (seconds)
LANG_CODE=en


# ------------------------------------------------------------------------------
# 6) LOGS
# ------------------------------------------------------------------------------
LOG_TO_TELEGRAM=True       # ERROR logs LOGGER_ID par bhejein
LOG_LEVEL=INFO
PLAY_LOG=True              # har play ka log logger group me
LOG_FILE=log.txt
CLEANUP_HOURS=24           # itne ghante baad purani downloads delete


# ------------------------------------------------------------------------------
# 7) BRANDING / SUPPORT (optional)
# ------------------------------------------------------------------------------
SUPPORT_CHANNEL=https://t.me/yourchannel
SUPPORT_CHAT=https://t.me/yourgroup
UPDATE_REPO=https://github.com/pm169298-boop/Music-x-bot
START_IMG=
PING_IMG=
DEFAULT_THUMB=https://te.legra.ph/file/3e40a408286d4eda24191.jpg

# ------------------------------------------------------------------------------
# 8) MAINTENANCE
# ------------------------------------------------------------------------------
# True karne par sirf sudo commands chalenge
MAINTENANCE=False
# True karne par sirf owner/sudo commands + /start
MANAGEMENT_MODE=False

# ------------------------------------------------------------------------------
# 5) FONT / DESIGN
# ------------------------------------------------------------------------------
# 17 fonts: smallcaps (default), bold, bold_sans, italic, bold_italic, script,
# bold_script, fraktur, bold_fraktur, double, mono, fullwidth, circled,
# neg_circled, parenthesized, tiny, neg_squared  (ya "off")
FONT_STYLE=smallcaps
FONT_ENABLED=True
DESIGN_ENABLED=True
OWNER_NAME=
BOT_NAME=Music-x-bot

# ------------------------------------------------------------------------------
# 6) FORCE JOIN  (comma separated — khaali = off)
# ------------------------------------------------------------------------------
FORCE_JOIN=

# ------------------------------------------------------------------------------
# 7) HEALTH / HEARTBEAT / VC IDLE
# ------------------------------------------------------------------------------
HEARTBEAT_MINUTES=15
HEARTBEAT_TO_ADMIN=True
AUTO_HEAL=True
VC_IDLE_LEAVE=True
VC_IDLE_SECONDS=120

# ------------------------------------------------------------------------------
# 8) SUPER ADMIN (owner ke saath extra admins add kar sakte hain)
# ------------------------------------------------------------------------------
SUPER_ADMIN_IDS=
