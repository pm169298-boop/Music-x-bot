# ==============================================================================
# TELEGRAM CREDENTIALS (MANDATORY)
# ==============================================================================
# Get API_ID and API_HASH from https://my.telegram.org (under API Development Tools)
API_ID=
API_HASH=

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=

# Assistant Account Session: Pyrogram v2 string session from @StringFatherBot on Telegram
SESSION=

# Your numeric Telegram user ID (from @userinfobot)
OWNER_ID=

# Private Telegram group ID for alerts, logs, and automatic database backups (e.g. -100...)
LOGGER_ID=


# ==============================================================================
# DATABASE CONFIGURATION (HYBRID ENGINE)
# ==============================================================================
# Option 1: Firebase Realtime Database (Optional)
# If you want to use Firebase, create a Firebase project, enable Realtime Database,
# and enter your database URL and service account key file path or raw JSON string.
FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS=firebase_key.json

# Option 2: Local VPS Storage Mode + Automated Backup Mode (DEFAULT)
# If FIREBASE_DATABASE_URL is left empty, the bot automatically saves data on your VPS
# in data/database.json, and automatically generates timestamped backup snapshots in
# data/backups/ every 6 hours and sends them to your Telegram LOGGER_ID!
BACKUP_INTERVAL_HOURS=6
MAX_BACKUPS_RETAINED=10


# ==============================================================================
# YOUTUBE COOKIES (OPTIONAL)
# ==============================================================================
# Path to YouTube cookies file to bypass bot verification on datacenters
COOKIES_FILE=cookies.txt
